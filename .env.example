# Copy this file to .env.local and fill in the values.
# Supabase dashboard > Project Settings > API Keys (and Data API for the URL).

# Your project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe in the browser: RLS blocks everything until you log in.
# Older projects call this the "anon" key; that works too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). SERVER/SCRIPTS ONLY, never add a NEXT_PUBLIC_ prefix.
# Only used by `npm run seed`. Older projects call this the "service_role" key.
SUPABASE_SECRET_KEY=

# Optional locally. On Vercel, set any long random string; Vercel's cron sends it to /api/health.
CRON_SECRET=
